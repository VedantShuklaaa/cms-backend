# Postgres container (read by docker compose)
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=cms

# Backend (password must match POSTGRES_PASSWORD, URL-encode special characters)
DATABASE_URL=postgres://cms_user:your_password@localhost:5432/cms
DB_MAX_CONNECTIONS=10
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000

# Must be at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRATION_MINUTES=1440